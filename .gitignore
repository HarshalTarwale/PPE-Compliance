# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# ML artifacts (ignore temporary or heavy runs)
*.engine
*.tflite
runs/
wandb/

# Data (keep folder structure, ignore heavy files)
data/raw/
data/processed/
!data/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep

# Models: track only required production weights (<50MB total)
!models/weights/best.pt
!models/weights/ppe_5class_best.pt
!models/face/*.onnx
!models/.gitkeep
!models/weights/.gitkeep

# Outputs (reports & fallback test image)
outputs/
!outputs/.gitkeep
!outputs/pipeline_test.jpg

# Logs
logs/
*.log

# Environment
.env

# Safety event history written at runtime
data/events/
